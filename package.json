{
  "name": "1999-xiaohuanxiong-shuihu-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/generate-catalog.mjs",
    "assets:check": "node scripts/generate-catalog.mjs --check",
    "predev": "npm run assets:generate",
    "dev": "vite",
